#!/bin/bash

set -Eeuo pipefail

checkov_image_name="bridgecrew/checkov:3.2.74"
docker_cli_image_name="docker:27.3.1-cli"
docker_dind_image_name="docker:27.3.1-dind"
python_image_name="python:3.9.20"
terraform_upstream_image_name="hashicorp/terraform:1.9.8"
terraform_image_name="hashicorp/terraform:1.9.8"

# TODO: Install specific python vesion 3.9.20 using pyenv.
function alpine_python_install (
  apk --update-cache --no-cache add python3 py3-pip
  python3 -m venv venv
  . venv/bin/activate
  pip3 install --upgrade pip && pip3 install --upgrade setuptools
)

# TODO: Generate report Gitlab can consume.
function alpine_python_checkov_install_and_run (
  . venv/bin/activate
  pip3 install checkov
  checkov --directory infrastructure
)

function alpine_shellcheck_install_and_run (
  apk --update-cache --no-cache add shellcheck xmlstarlet
  # Unfortunately shellcheck can only display checkstyle or tty outputs - not both.
  # See here for more details: https://github.com/koalaman/shellcheck/wiki/checkstyle2text
  # First lets run shellcheck in default tty mode (and ignore any errors).
  shellcheck -e SC2181 upload/data_upload.sh || true
  # And again run Shellcheck in checkstyle mode to generate a JUnitXML report.
  # See https://github.com/koalaman/shellcheck/wiki/JUnit for JUnit encoding.
  shellcheck -f checkstyle -e SC2181 upload/data_upload.sh | xmlstarlet tr misc/checkstyle/checkstyle2junit.xslt > shellcheck_report.xml
)

function bats_remove_log_files (
  # remove the log files first
  rm -f ./upload/test/bats/error.txt
  rm -f ./upload/test/bats/success.txt
  rm -f ./upload/test/bats/sync_logs.txt
  rm -f ./upload/test/bats/plan.txt
)

function alpine_bats_install_and_run (
  # remove the log files first
  bats_remove_log_files
  cd upload/test/bats/
  apk --update-cache --no-cache add file bats bats-core bats-support bats-assert bats-file
  bats --report-formatter junit ./* --output /tmp
)

command="$1"
set +u
case "${command}" in
  checkov)
      docker run --rm -v $PWD:/tmp/niwa $checkov_image_name --directory /tmp/niwa/infrastructure
      ;;
  checkov_i)
      # interactive
      docker run --rm --entrypoint=/bin/bash -v $PWD:/tmp/niwa -ti $checkov_image_name -c /bin/bash
      ;;
  checkov_alpine)
      alpine_python_install
      alpine_python_checkov_install_and_run
      ;;
  shellcheck)
      docker run -t --rm --entrypoint=/bin/sh -v $PWD:/tmp/niwa koalaman/shellcheck-alpine:v0.10.0 -c "shellcheck -e SC2181 /tmp/niwa/upload/data_upload.sh"
      ;;
  shellcheck_alpine)
      alpine_shellcheck_install_and_run
      ;;
  bats)
      # remove the log files first
      bats_remove_log_files

      # We need the 'file' command for the data upload script. That command
      # is not installed in the docker image. Therefore, we install it below.
      docker run -t --rm --entrypoint=/bin/sh -v $PWD:/tmp/niwa bats/bats:1.11.0 -c "cd /tmp/niwa/upload/test/bats/ && apk add -U file && bats ./*"
      ;;
  bats_alpine)
      alpine_bats_install_and_run
      ;;
  *)
      echo "Invalid command: '${command}'"
      exit 1
      ;;
esac
set +e
